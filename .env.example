# Copy to .env and fill these values using your secret manager or local shell.
DATABASE_URL=postgresql+psycopg://aerointel:replace-me@db:5432/aerointel
POSTGRES_DB=aerointel
POSTGRES_USER=aerointel
POSTGRES_PASSWORD=replace-me
JWT_SECRET_KEY=replace-with-a-random-value-at-least-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=480
RUN_MIGRATIONS=true
LOG_LEVEL=INFO

GOOGLE_API_KEY=replace-me
GEMINI_MODEL_PRIMARY=gemini-3.8-flash
GEMINI_MODEL_FALLBACK=gemini-3.6-flash

PINECONE_API_KEY=replace-me
PINECONE_INDEX_NAME=aerointel-v2
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_INDEX_READY_TIMEOUT=180

# Optional: host port for localhost access (never expose port 8000 directly).
AEROINTEL_HOST_PORT=8000
