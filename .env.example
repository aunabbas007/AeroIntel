# Copy to .env locally. Never commit real credentials.
DATABASE_URL=postgresql+psycopg://aerointel:replace-me@db:5432/aerointel
POSTGRES_DB=aerointel
POSTGRES_USER=aerointel
POSTGRES_PASSWORD=replace-me

JWT_SECRET_KEY=replace-with-a-random-value-at-least-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=480
RUN_MIGRATIONS=true
LOG_LEVEL=INFO

# Production currently uses Groq through LiteLLM in api.py.
GROQ_API_KEY=replace-me
GROQ_MODEL=groq/openai/gpt-oss-120b

# Used by standalone Gemini/LangGraph experiments and evaluation.
GOOGLE_API_KEY=replace-me
GEMINI_MODEL_PRIMARY=gemini-3.8-flash
GEMINI_MODEL_FALLBACK=gemini-3.6-flash

PINECONE_API_KEY=replace-me
PINECONE_INDEX_NAME=aerointel-v2
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_INDEX_READY_TIMEOUT=180

# Keep dense as the safe default. Compare retrieval evaluation before switching.
AEROINTEL_RETRIEVAL_MODE=dense
AEROINTEL_RETRIEVAL_K=3
AEROINTEL_RERANKER_ENABLED=false
AEROINTEL_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
AEROINTEL_CACHE_VERSION=v2
REDIS_CACHE_TTL_SECONDS=3600

# Optional: host port for localhost access only.
AEROINTEL_HOST_PORT=8000
